{
  "manifestVersion": 2,
  "id": "claude-trajectory",
  "name": "Claude Trajectory",
  "version": "0.1.0",
  "repository": "https://github.com/chrisluo5311/orca-claude-trajectory",
  "description": "What a Claude Code session did, request by request: prompts, model requests, tool calls and subagents, with tokens and timing. Reads transcripts locally, read-only.",
  "author": { "name": "chrisluo5311", "url": "https://github.com/chrisluo5311" },
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.247"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "trajectory",
        "title": "Claude Trajectory",
        "icon": "activity",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ]
  },
  "capabilities": [
    { "kind": "workspace:read" },
    { "kind": "agent:read" }
  ]
}
